  "productName": "Claude Session Manager",
  "version": "0.9.2",
  "identifier": "com.levit.claude-session-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "https://claude-session-manager.vercel.app"
  },
  "app": {
